<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <header class="header">
        <a href="#" class="logo"></a>
        <i class="glyphicon glyphicon-align-justify icon-left-panel"></i>
    </header>
    <div class="content">
        <div class="left-panel">
            <ul class="list-unstyled">
                <li><a href="#">Dashboard</a></li>
                <li><a href="#">Css</a></li>
                <li><a href="#">Javascript</a></li>
                <li class="has-child">
                    <span>Web controls</span>
                    <ul class="sub-menu list-unstyled">
                        <li><a href="#">Calendar</a></li>
                        <li><a href="#">Context menu</a></li>
                        <li><a href="#">Nav</a></li>
                        <li><a href="#">Dropdown list</a></li>
                        <li><a href="#">Tree</a></li>
                        <li><a href="#">Tooltip</a></li>
                        <li><a href="#">Textbox</a></li>
                        <li><a href="#">Checkbox</a></li>
                        <li><a href="#">Radio button</a></li>
                        <li><a href="#" class="active">Button</a></li>
                        <li><a href="#">Chart</a></li>
                        <li><a href="#">Countdown Timer</a></li>
                        <li><a href="#">Switch</a></li>
                        <li><a href="#">Dialog</a></li>
                        <li><a href="#">List</a></li>
                        <li><a href="#">Panel</a></li>
                        <li><a href="#">Tab</a></li>
                        <li><a href="#">Message box</a></li>
                        <li><a href="#">Progress</a></li>
                        <li><a href="#">Breadcrumb</a></li>
                    </ul>
                </li>
            </ul>
        </div>
        <div class="right-panel">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-sm-12">
                        <ol class=" breadcrumb cust-breadcrumb">
                            <li>Web controls</li>
                            <li><a href="#">Button</a></li>
                        </ol>
                    </div>
                </div>
                <div class="row">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>