@{
    ViewBag.Title = "Textbox";
}

<div class="col-sm-12">
    <p>Textbox allow users to input data sush as text, character, date, datetime, ... or only input text and limit about characters or only input with formating date and datetime.</p>
    <!-- Default textbox -->
    <h2 class="sub-title">Default textbox</h2>
    <p>Textbox is formated with material design when it is used in <code>form</code> and the <code>input</code> tag adds the <span class="txt-class">.form-control</span> class. </p>
    <div class="docs-section">
        <div class="btn btn-primary btn-xs withripple view-source">&lt; Source &gt;</div>
        <div class="example-section">
            <h2>Example</h2>
            <div class="demo-section row">
                <form class="form-horizontal col-sm-8 col-md-5" role="form">
                    <div class="form-group">
                        <label for="username3" class="col-sm-3 control-label">Username</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control" id="username3" placeholder="Username">
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="inputPassword3" class="col-sm-3 control-label">Password</label>
                        <div class="col-sm-9">
                            <input type="password" class="form-control" id="inputPassword3" placeholder="Password">
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-sm-offset-3 col-sm-9">
                            <input type="button" class="btn btn-info" value="Login" />
                        </div>
                    </div>
                </form>                
            </div>
        </div>
        <div class="code-section">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active"><a href="#html" role="tab" data-toggle="tab">Html</a></li>
            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="html">
                    <pre class="brush: html">
                        <form class="form-horizontal col-sm-8 col-md-5" role="form">
                            <div class="form-group">
                                <label for="username3" class="col-sm-3 control-label">Username</label>
                                <div class="col-sm-9">
                                    <input type="text" class="form-control" id="username3" placeholder="Username">
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="inputPassword3" class="col-sm-3 control-label">Password</label>
                                <div class="col-sm-9">
                                    <input type="password" class="form-control" id="inputPassword3" placeholder="Password">
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-sm-offset-3 col-sm-9">
                                    <input type="button" class="btn btn-info" value="Login" />
                                </div>
                            </div>
                        </form>
                    </pre>
                </div>
            </div>
        </div>
    </div>
    <!-- Validate textbox -->
    <h2 class="sub-title">Validate textbox</h2>
    <ul>
        <li>Add more the <span class="txt-class">.has-success</span> class to <span class="txt-class">.form-group</span> class when textbox validates successfully.</li>
        <li>Add more the <span class="txt-class">.has-warning</span> class to <span class="txt-class">.form-group</span> class after the value of validation can correct or wrong.</li>
        <li>Add more the <span class="txt-class">.has-error</span> class to <span class="txt-class">.form-group</span> class when the validation fails.</li>
    </ul>
    <div class="docs-section">
        <div class="btn btn-primary btn-xs withripple view-source">&lt; Source &gt;</div>
        <div class="example-section">
            <h2>Example</h2>
            <div class="demo-section row">
                <form class="form-horizontal col-sm-12 col-md-7" role="form">
                    <div class="form-group has-success">
                        <label for="firstname" class="col-sm-3 control-label">First name</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control" id="firstname" placeholder="First name" value="Marc">
                        </div>
                    </div>
                    <div class="form-group has-warning">
                        <label for="lastname" class="col-sm-3 control-label">Last name</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control" id="lastname" placeholder="Last name" value="aa">
                        </div>
                    </div>
                    <div class="form-group has-error">
                        <label for="email" class="col-sm-3 control-label">Email</label>
                        <div class="col-sm-9">
                            <input type="email" class="form-control" id="email" placeholder="Email" value="test.com">
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="phone" class="col-sm-3 control-label">Phone</label>
                        <div class="col-sm-9">
                            <input type="email" class="form-control" id="phone" placeholder="Phone">
                        </div>
                    </div>                    
                    <div class="form-group">
                        <div class="col-sm-offset-3 col-sm-9">
                            <input type="button" class="btn btn-primary" value="Submit" />
                        </div>
                    </div>
                </form>
            </div>
        </div>
