@{
    ViewBag.Title = "Breadcrumb";
}

<div class="col-sm-12">
    <p>Indicate the current page's location within a navigational hierarchy. Separators are automatically added in CSS through <span class="txt-class">:before</span> and content.</p>
    <div class="docs-section">
        <div class="btn btn-primary btn-xs withripple view-source">&lt; Source &gt;</div>
        <div class="example-section">
            <h2>Example</h2>
            <div class="demo-section">
                <ol class="breadcrumb">
                    <li>Home</li>
                </ol>
                <ol class="breadcrumb">
                    <li><a href="#">Home</a></li>
                    <li>Library</li>
                </ol>
                <ol class="breadcrumb">
                    <li><a href="#">Home</a></li>
                    <li><a href="#">Library</a></li>
                    <li class="active">Data</li>
                </ol>
            </div>
        </div>
        <div class="code-section">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active"><a href="#basicHtml" role="tab" data-toggle="tab">Html</a></li>
            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="basicHtml">
                    <pre class="brush: html">
                        <ol class="breadcrumb">
                            <li>Home</li>
                        </ol>
                        <ol class="breadcrumb">
                            <li><a href="#">Home</a></li>
                            <li>Library</li>
                        </ol>
                        <ol class="breadcrumb">
                            <li><a href="#">Home</a></li>
                            <li><a href="#">Library</a></li>
                            <li class="active">Data</li>
                        </ol>
                    </pre>
                </div>
            </div>
        </div>
    </div>
</div>