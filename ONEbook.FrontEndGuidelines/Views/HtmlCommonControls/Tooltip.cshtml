@{
    ViewBag.Title = "Tooltip";
}
<div class="col-sm-12">
    <p>Showing instruction, note, etc. when user hovers the mouse on button/icon.</p>
    <div class="docs-section">
        <div class="btn btn-primary btn-xs withripple view-source">&lt; Source &gt;</div>
        <div class="example-section">
            <h2>Example</h2>
            <div class="demo-section">
                <div class="row" >
                    <div class="col-sm-7 col-sm-offset-3">
                        <button type="button" class="btn btn-primary" data-toggle="tooltip" data-placement="left" title="" data-original-title="Tooltip on left">Left</button>
                        <button type="button" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="" data-original-title="Tooltip on top">Top</button>
                        <button type="button" class="btn btn-primary" data-toggle="tooltip" data-placement="bottom" title="" data-original-title="Tooltip on bottom">Bottom</button>
                        <button type="button" class="btn btn-primary" data-toggle="tooltip" data-placement="right" title="" data-original-title="Tooltip on right">Right</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="code-section">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active"><a href="#tooltipHtml" role="tab" data-toggle="tab">Html</a></li>
                <li role="presentation"><a href="#tooltipJavascript" role="tab" data-toggle="tab">JavaScript</a></li>
            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="tooltipHtml">
                    <pre class="brush: html">
                        <button type="button" class="btn btn-primary" data-toggle="tooltip" data-placement="left" title="" data-original-title="Tooltip on left">Left</button>
                        <button type="button" class="btn btn-primary" data-toggle="tooltip" data-placement="top" title="" data-original-title="Tooltip on top">Top</button>
                        <button type="button" class="btn btn-primary" data-toggle="tooltip" data-placement="bottom" title="" data-original-title="Tooltip on bottom">Bottom</button>
                        <button type="button" class="btn btn-primary" data-toggle="tooltip" data-placement="right" title="" data-original-title="Tooltip on right">Right</button>
                    </pre>
                </div>
                <div role="tabpanel" class="tab-pane" id="tooltipJavascript">
                    <pre class="brush: javascript">
                        /* global Namespace, ONEbook */

                        'use strict';

                        $(document).ready(function () {
                            var tooltipPage = new ONEbook.FrontEndGuidelines.Tooltip();

                            tooltipPage.Initialize();
                        });

                        Namespace.Register('ONEbook.FrontEndGuidelines.Tooltip');
                        ONEbook.FrontEndGuidelines.Tooltip = function () {
                            var me = this;

                            // Initialize the page.
                            me.Initialize = function () {
                                $('[data-toggle="tooltip"]').tooltip();
                            };
                        };
                    </pre>
                </div>
            </div>
        </div>
    </div>
    <!---------------------------->
</div>
@section scripts
{
    @Scripts.Render("~/bundles/controls/js/tooltip")
}