                    <pre class="brush: css">
                        /********************************************************/
                        /*                     Customize menu                   */
                        /********************************************************/
                        &#64;border-color: #d9d9d9;
                        &#64;font-size: 13px;
                        &#64;text-color: #666;

                        .table {
                            thead {
                                th {
                                    text-align: center;
                                }
                            }
                            td {
                                vertical-align: middle;
                            }
                        }

                        .icon-view, .icon-delete {
                            font-size: &#64;font-size + 3;
                            padding: 1px;
                            border: 1px solid &#64;border-color;
                            margin: 0 4px;
                            cursor: pointer;
                            color: &#64;text-color;
                            .border-radius(2px);

                            &:hover, &.active {
                                color: #9e9e9e;
                            }
                        }

                        .context-menu {
                            position: relative;

                            .content-menu {
                                display: none;
                                position: absolute;
                                top: 25px;
                                left: 0px;
                                z-index: 100;
                                padding: 0;
                                background-color: #fafafa;
                                list-style: none;
                                border: 1px solid &#64;border-color;
                                .border-radius(2px);
                                .box-shadow(1px 1px 2px #ccc);

                                li {
                                    white-space: nowrap;
                                    padding: 3px 10px;
                                    border-top: 1px solid #dfdfdf;
                                    min-width: 100px;

                                    &:first-child {
                                        border-top: none;
                                    }

                                    &:hover {
                                        background-color: #f3f3f3;
                                    }

                                    a {
                                        display: block;
                                        &:hover {
                                            text-decoration: none;
                                        }
                                    }
                                }

                                &:before, &:after {
                                    content: "";
                                    border-color: transparent transparent #fff transparent;
                                    border-style: solid;
                                    border-width: 8px;
                                    width: 0;
                                    height: 0;
                                    position: absolute;
                                    top: -15px;
                                    left: 6px;
                                    z-index: 102;
                                }

                                &:after {
                                    border-color: transparent transparent #dfdfdf transparent;
                                    border-width: 9px;
                                    top: -18px;
                                    left: 5px;
                                    z-index: 101;
                                }
                            }
                        }
                    </pre>
                </div>
                <div role="tabpanel" class="tab-pane active" id="javascript">
                    <pre class="brush: javascript">
                        'use strict';

                        $(document).ready(function () {
                            var contextmenu = new ONEbook.FrontEndGuidelines.ContextMenu();
                            contextmenu.Initialize();
                        });

                        Namespace.Register('ONEbook.FrontEndGuidelines.ContextMenu');

                        ONEbook.FrontEndGuidelines.ContextMenu = function () {
                            var me = this;
    
                            var showContextMenu = function () {
                                var iconView = $('.icon-view'),
                                    iconDelete = $('.icon-delete'),
                                    contentMenu = $('.content-menu');

                                iconView.on('click', function () {
                                    var $this = $(this);

                                    if ($this.hasClass('active')) {
                                        $this.removeClass('active');
                                        $this.siblings('.content-menu').hide();
                                    } else {
                                        $this.addClass('active');
                                        contentMenu.hide();
                                        $this.siblings('.content-menu').show();
                                    }            
                                });

                                iconDelete.on('click', function () {
                                    var $this = $(this),
                                        confirmMsg = confirm('Do you want to delete?');
                                    if (confirmMsg) {
                                        $this.parent().parent().remove();
                                    }
                                });
                            };

                            me.Initialize = function () {
                                showContextMenu();
                            };
                        };
                    </pre>
