@{
    ViewBag.Title = "Switch";
}

@section css
{
    @Styles.Render("~/bundles/controls/css/switch")
}

@section scripts
{
    @Scripts.Render("~/bundles/controls/js/switch")
}

<div class="col-sm-12">
    <p>We use <a href="http://www.bootstrap-switch.org/">Bootstrap Switch</a> plugin to turn checkboxes and radio buttons in toggle switches</p>
    <p>
        Some scenarios <a href="http://www.bootstrap-switch.org/">Bootstrap Switch</a> can be applied are:
        <ul>
            <li><a href="#turnCheckboxToSwitch">Turn checkboxes in toggle switches.</a></li>
            <li><a href="#turnRadioToSwitch">Turn radio buttons in toggle switches.</a></li>
        </ul>
    </p>
    <!-- Turn checkboxes in toggle switches -->
    <h2 class="sub-title" id="turnCheckboxToSwitch">Turn checkboxes in toggle switches.</h2>
    <div class="docs-section">
        <div class="btn btn-primary btn-xs withripple view-source">&lt; Source &gt;</div>
        <div class="example-section">
            <h2>Example</h2>
            <div class="demo-section">
                <p>
                    <input type="checkbox" checked />
                </p>
                <p>
                    <input type="checkbox" />
                </p>
            </div>
        </div>
        <div class="code-section">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active"><a href="#html-switch-checkbox" role="tab" data-toggle="tab">Html</a></li>
                <li role="presentation"><a href="#javascript-switch-checkbox" role="tab" data-toggle="tab">JavaScript</a></li>
            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="html-switch-checkbox">
                    <pre class="brush: html">
                        &lt;input type="checkbox" checked /&gt;
                        &lt;input type="checkbox" /&gt;
                    </pre>
                </div>
                <div role="tabpanel" class="tab-pane" id="javascript-switch-checkbox">
                    <pre class="brush: javascript">
                        $("input[type='checkbox']").bootstrapSwitch();
                    </pre>
                </div>
            </div>
        </div>
    </div>

    <!-- Turn radio buttons in toggle switches. -->
    <h2 class="sub-title" id="turnRadioToSwitch">Turn radio buttons in toggle switches.</h2>
    <div class="docs-section">
        <div class="btn btn-primary btn-xs withripple view-source">&lt; Source &gt;</div>
        <div class="example-section">
            <h2>Example</h2>
            <div class="demo-section">
                <p><input type="radio" name="radio1" checked class="switch-radio1" /></p>
                <p><input type="radio" name="radio1" class="switch-radio1" /> </p>
                <p><input type="radio" name="radio1" class="switch-radio1" /></p>
            </div>
        </div>
        <div class="code-section">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active"><a href="#html-switch-radio" role="tab" data-toggle="tab">Html</a></li>
                <li role="presentation"><a href="#javascript-switch-radio" role="tab" data-toggle="tab">JavaScript</a></li>
            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="html-switch-radio">
                    <pre class="brush: html">
                        &lt;input type="radio" name="radio1" checked class="switch-radio1"&gt;
                        &lt;input type="radio" name="radio1" class="switch-radio1"&gt;
                        &lt;input type="radio" name="radio1" class="switch-radio1"&gt;
                    </pre>
                </div>
                <div role="tabpanel" class="tab-pane" id="javascript-switch-radio">
                    <pre class="brush: javascript">
                        $("input[type='radio']").bootstrapSwitch();
                    </pre>
                </div>
            </div>
        </div>
    </div>
</div>