@{
    ViewBag.Title = "Routing Rules";
}

@section css
{
    @Styles.Render("~/bundles/controls/css/aspmvc")
}

<div class="col-sm-12" id="doc-content">
    <ul class="rule-list">
        <li><a href="#" class="link-sub-title" code="OW15000">OW15000 ORDER routes from specific to general when using standard routing</a></li>
        <li><a href="#" class="link-sub-title" code="OW15001">OW15001 USE named route mechanism to avoid route ambiguity</a></li>
    </ul>
    <ul class="rules unordered">        
        <li>
            <h2 class="sub-title first" id="OW15000"><span class="rule-item">OW15000 </span> ORDER routes from specific to general when using standard routing <span class="lbl-importance">**</span></h2>
            <div class="example-code none-top-content">
                <pre class="brush: csharp">
                    public static void RegisterRoutes(RouteCollection routes)
                    {
                        routes.MapRoute(
                            null,
                            "",
                            new { controller = "Products", action = "List", category = (string)null, page = 1 }
                            );
                        routes.MapRoute(
                            null,
                            "Page{page}",
                            new { controller = "Products", action = "List", category = (string)null },
                            new { page = &#64;"\d+" }
                            );
                        routes.MapRoute(
                            null,
                            "{category}",
                            new { controller = "Products", action = "List", page = 1 }
                            );
                        routes.MapRoute(
                            null,
                            "{category}/Page{page}",
                            new { controller = "Products", action = "List" },
                            new { page = &#64;"\d+" }
                            );
                    }
                </pre>
            </div>
            <p>The general route should be on top and specific route should be place in bottom.</p>
        </li>
        <li>
            <h2 class="sub-title" id="OW15000"><span class="rule-item">OW15001 </span> USE named route mechanism to avoid route ambiguity <span class="lbl-importance">**</span></h2>
            <p>For example, the following route mapping defines named routes:</p>
            <div class="example-code">
                <pre class="brush: csharp">
                    public static void RegisterRoutes(RouteCollection routes)
                    {
                        routes.MapRoute(
                            "Default",
                            "",
                            new { controller = "Products", action = "List", category = (string)null, page = 1 }
                            );
                        routes.MapRoute(
                            "PageRoute",
                            "Page{page}",
                            new { controller = "Products", action = "List", category = (string)null },
                            new { page = &#64;"\d+" }
                            );
                    }
                </pre>
            </div>
        </li>
    </ul>
</div>
