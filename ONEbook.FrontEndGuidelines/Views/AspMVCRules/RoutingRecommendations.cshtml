@{
    ViewBag.Title = "Routing Recommendations";
}

@section css
{
    @Styles.Render("~/bundles/controls/css/aspmvc")
}

<div class="col-sm-12" id="doc-content">
    <ul class="list-unstyled more-info">
        <li><span class="badge lbl-importance">***</span> Guidelines that you should never skip and should be applicable to all situations.</li>
        <li><span class="badge lbl-importance">**</span> Strongly recommended guidelines.</li>
        <li><span class="badge lbl-importance">*</span> Recommended guidelines that may not be applicable in all situations.</li>
    </ul>
    <ol class="rules">        
        <li>
            <h2 class="sub-title">OW5017 ORDER routes from specific to general when using standard routing <span class="badge lbl-importance">**</span></h2>
            <div class="example-code">
                <pre class="brush: csharp">
                        public static void RegisterRoutes(RouteCollection routes)
                        {
                            routes.MapRoute(
                                null,
                                "",
                                new { controller = "Products", action = "List", category = (string)null, page = 1 }
                                );
                            routes.MapRoute(
                                null,
                                "Page{page}",
                                new { controller = "Products", action = "List", category = (string)null },
                                new { page = &#64;"\d+" }
                                );
                            routes.MapRoute(
                                null,
                                "{category}",
                                new { controller = "Products", action = "List", page = 1 }
                                );
                            routes.MapRoute(
                                null,
                                "{category}/Page{page}",
                                new { controller = "Products", action = "List" },
                                new { page = &#64;"\d+" }
                                );
                        }
                        </pre>
            </div>
            <p>The general route should be on top and specific route should be place in bottom.</p>
        </li>
        <li>
            <h2 class="sub-title">OW5018 USE named route mechanism to avoid route ambiguity <span class="badge lbl-importance">**</span></h2>
            <p>For example, the following route mapping defines named routes:</p>
            <div class="example-code">
                <pre class="brush: csharp">
                        public static void RegisterRoutes(RouteCollection routes)
                        {
                            routes.MapRoute(
                                "Default",
                                "",
                                new { controller = "Products", action = "List", category = (string)null, page = 1 }
                                );
                            routes.MapRoute(
                                "PageRoute",
                                "Page{page}",
                                new { controller = "Products", action = "List", category = (string)null },
                                new { page = &#64;"\d+" }
                                );
                        }
                    </pre>
            </div>
        </li>
    </ol>
</div>
@section scripts
{
    @Scripts.Render("~/bundles/controls/js/aspmvc")
}

