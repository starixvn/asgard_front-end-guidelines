@{
    ViewBag.Title = "HTML Rules";
}
<div class="col-sm-12">
    <ul class="rule-list">
        <li><a href="#" class="link-sub-title" code="OWH001">OWH001 Use HTML5 doctype declaration</a></li>
        <li><a href="#" class="link-sub-title" code="OWH002">OWH002 Remove all trailing whitespaces</a></li>
        <li><a href="#" class="link-sub-title" code="OWH003">OWH003 Use spaces instead of tabs</a></li>
        <li><a href="#" class="link-sub-title" code="OWH004">OWH004 All HTML code must pass the tests of W3C HTML validator or HTML validator addon of FireFox </a></li>
        <li><a href="#" class="link-sub-title" code="OWH005">OWH005 Use elements for what they have been created for</a></li>
        <li><a href="#" class="link-sub-title" code="OWH006">OWH006 Provide alternative contents for multimedia</a></li>
        <li><a href="#" class="link-sub-title" code="OWH007">OWH007 Separate structure from presentation and behavior</a></li>
        <li><a href="#" class="link-sub-title" code="OWH008">OWH008 Do not use type attributes for style sheets (unless not using CSS) and scripts (unless not using JavaScript)</a></li>
        <li><a href="#" class="link-sub-title" code="OWH009">OWH009 Use a new line for every block, list, or table element, and indent every such child element</a></li>
        <li><a href="#" class="link-sub-title" code="OWH010">OWH010 When quoting attributes values, use double quotation marks</a></li>
    </ul>
    <ul class="rules unordered">
        <li>
            <h2 class="sub-title first" id="OWH001"><span class="rule-item">OWH001 </span> Use HTML5 doctype declaration</h2>
            <div class="example-code none-top-content">
                <pre class="text-success">@("<!DOCTYPE html>")</pre>
            </div>
        </li>
        <li>
            <h2 class="sub-title" id="OWH002"><span class="rule-item">OWH002 </span> Remove all trailing whitespaces</h2>
            <p>
                The number of whitespaces for a tab may vary with many editors, thus using whitespace instead of tab helps to keep the format of code be the same.
                Do not use tabs or mix tabs and spaces for indentation.
            </p>
        </li>
        <li>
            <h2 class="sub-title" id="OWH003"><span class="rule-item">OWH003 </span> Use spaces instead of tabs</h2>
            <p>The trailing whitespaces are unnecessary and can complicate diffs.</p>
        </li>
        <li>
            <h2 class="sub-title" id="OWH004">
                <span class="rule-item">OWH004 </span> All HTML code must pass the tests of <a href="http://validator.w3.org/nu/" target="_blank"> W3C HTML validator</a>
                or <a href="https://addons.mozilla.org/en-US/firefox/addon/html-validator/" target="_blank">HTML validator addon</a> of FireFox
            </h2>
            <p>
                Using valid HTML is a measurable baseline quality attribute that contributes to learning about technical
                requirements and constraints, and that ensures proper HTML usage.
            </p>
            <div class="example-code">
                <pre class="text-danger">@(@"
                    <!-- Not recommended -->
                    <title>Test</title>
                    <article>This is only a test.")
                </pre>
                <pre class="text-success">@(@"
                    <!-- Recommended -->
                    <!DOCTYPE html>
                    <meta charset=""utf-8"">
                    <title>Test</title>
                    <article>This is only a test.</article>")
                </pre>
            </div>
        </li>
        <li>
            <h2 class="sub-title" id="OWH005"><span class="rule-item">OWH005 </span> Use elements for what they have been created for</h2>
            <p>
                For example, use heading elements for headings, <code>p</code> elements for paragraphs, <code>a</code> elements for anchors, etc.
                Its purpose is important for accessibility, reuse, and code efficiency reasons.
            </p>
            <div class="example-code">
                <pre class="text-danger">@(@"
                    <!-- Not recommended -->
                    <div onclick=""goToRecommendations();"">All recommendations</div>")
                </pre>
                <pre class="text-success">@(@"
                    <!-- Recommended -->
                    <a href=""recommendations/"">All recommendations</a>")
                </pre>
            </div>
        </li>
        <li>
            <h2 class="sub-title" id="OWH006"><span class="rule-item">OWH006 </span> Provide alternative contents for multimedia</h2>
            <p>
                For images that means the meaningful alternative text (<code>alt</code>);
                for video and audio those are transcripts and captions, if available.
            </p>
            <div class="example-code">
                <pre class="text-danger">@(@"
                    <!-- Not recommended -->
                    <img src=""\nexcel.png"" />")
                </pre>
                <pre class="text-success">@(@"
                    <!-- Recommended -->
                    <img src=""\nexcel.png"" alt=""Nexcel logo."" />")
                </pre>
            </div>
        </li>
        <li>
            <h2 class="sub-title" id="OWH007"><span class="rule-item">OWH007 </span> Separate structure from presentation and behavior</h2>
            <p>
                Strictly keep structure (markup), presentation (styling), and behavior (scripting) apart,
                and try to keep the interaction between the three to an absolute minimum.
                It is important for maintenance reasons.
            </p>
            <div class="example-code">
                <pre class="text-danger">@(@"
                    <!-- Not recommended -->
                    <!DOCTYPE html>
                    <title>HTML sucks</title>
                    <link rel=""stylesheet"" href=""site.css"" media=""screen"" />
                    <link rel=""stylesheet"" href=""print.css"" media=""print"" />
                    <h1 style=""font-size: 1em;"">HTML sucks</h1>
                    <p>I’ve read about this on a few sites but now I’m sure:
                    <u>HTML is stupid!!1</u>
                    <center>I can’t believe there’s no way to control the styling of
                      my website without doing everything all over again!</center>
                    </p>")
                </pre>
                <pre class="text-success">@(@"
                    <!-- Recommended -->
                    <!DOCTYPE html>
                    <title>My first CSS-only redesign</title>
                    <link rel=""stylesheet"" href=""default.css"" />
                    <h1>My first CSS-only redesign</h1>
                    <p>I’ve read about this on a few sites but today I’m actually
                      doing it: separating concerns and avoiding anything in the HTML of
                      my website that is presentational.</p>
                    <p>It’s awesome!</p>")
                </pre>
            </div>
        </li>
        <li>
            <h2 class="sub-title" id="OWH008"><span class="rule-item">OWH008 </span> Do not use <code>type</code> attributes for style sheets (unless not using CSS) and scripts (unless not using JavaScript)</h2>
            <p>
                Specifying <code>type</code> attributes in these contexts is not necessary as HTML5 implies <code>text/css</code> and <code>text/javascript</code> as defaults.
                This can be safely done even for older browsers.
            </p>
            <div class="example-code">
                <pre class="text-danger">@(@"
                    <!-- Not recommended -->
                    <link rel=""stylesheet"" href=""//www.google.com/css/maia.css"" type=""text/css"">")
                </pre>
                <pre class="text-success">@(@"
                    <!-- Recommended -->
                    <link rel=""stylesheet"" href=""//www.google.com/css/maia.css"">")
                </pre>
                <pre class="text-danger">@(@"
                    <!-- Not recommended -->
                    <script src=""//www.google.com/js/gweb/analytics/autotrack.js"" type=""text/javascript""></script>")
                </pre>
                <pre class="text-success">@(@"
                    <!-- Recommended -->
                    <script src=""//www.google.com/js/gweb/analytics/autotrack.js""></script>")
                </pre>
            </div>
        </li>
        <li>
            <h2 class="sub-title" id="OWH009"><span class="rule-item">OWH009 </span> Use a new line for every block, list, or table element, and indent every such child element</h2>
            <div class="example-code none-top-content">
                <pre class="text-success">@(@"
                    <ul>
                      <li>Ricky</li>
                      <li>Alice</li>
                      <li>Jason</li>
                    </ul>")
                </pre>
            </div>
        </li>
        <li>
            <h2 class="sub-title" id="OWH010"><span class="rule-item">OWH010 </span> When quoting attributes values, use double quotation marks</h2>
            <div class="example-code none-top-content">
                <pre class="text-danger">@(@"
                    <!-- Not recommended -->
                    <a class='maia-button maia-button-secondary'>Sign in</a>")
                </pre>
                <pre class="text-success">@(@"
                    <!-- Recommended -->
                    <a class=""maia-button maia-button-secondary"">Sign in</a>")
                </pre>
            </div>
        </li>
    </ul>
</div>
@section scripts
{
    @Scripts.Render("~/bundles/rules/js")
}