@{
    ViewBag.Title = "Button";
}
<div class="col-sm-12">
    <div class="block">
        <h1 class="title">Overview</h1>
        <p>Use any of the available button classes to quickly create a styled button.</p>
        <h2 class="block-title">Default buttons</h2>
        <p>This is the basic set of button</p>
        <div class="docs-section">
            <div class="example-section">
                <h2>Example</h2>
                <div class="demo-section">
                    <button class="btn btn-default">Default</button>
                    <button class="btn btn-primary">Primary</button>
                    <button class="btn btn-success">Success</button>
                    <button class="btn btn-info">Info</button>
                    <button class="btn btn-warning">Warning</button>
                    <button class="btn btn-danger">Danger</button>
                </div>
            </div>
            <div class="code-section">
                <!-- Nav tabs -->
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" class="active"><a href="#html" role="tab" data-toggle="tab">Html</a></li>
                    <li role="presentation"><a href="#css" role="tab" data-toggle="tab">Css</a></li>
                </ul>
                <!-- Tab panes -->
                <div class="tab-content">
                    <div role="tabpanel" class="tab-pane active" id="html">
                        <pre>&lt;button class="btn btn-default"&gt;Default&lt;/button&gt;</br>&lt;button class="btn btn-primary"&gt;Default&lt;/button&gt; </br>&lt;button class="btn btn-success"&gt;Default&lt;/button&gt;</br>&lt;button class="btn btn-info"&gt;Default&lt;/button&gt;</br>&lt;button class="btn btn-warning"&gt;Default&lt;/button&gt;</br>&lt;button class="btn btn-danger"&gt;Default&lt;/button&gt;                  
                        </pre>
                    </div>
                    <div role="tabpanel" class="tab-pane" id="css">Css</div>
                </div>
            </div>
        </div>
        <h2 class="block-title">Flat buttons</h2>
        <p>This is the basic set of button</p>
        <div class="docs-section">
            <div class="example-section">
                <h2>Example</h2>
                <div class="demo-section">
                    <button class="btn btn-default">Default</button>
                    <button class="btn btn-primary">Primary</button>
                    <button class="btn btn-success">Success</button>
                    <button class="btn btn-info">Info</button>
                    <button class="btn btn-warning">Warning</button>
                    <button class="btn btn-danger">Danger</button>
                </div>
            </div>
            <div class="code-section">
                <!-- Nav tabs -->
                <ul class="nav nav-tabs" role="tablist">
                    <li role="presentation" class="active"><a href="#html" role="tab" data-toggle="tab">Html</a></li>
                    <li role="presentation"><a href="#css" role="tab" data-toggle="tab">Css</a></li>
                </ul>
                <!-- Tab panes -->
                <div class="tab-content">
                    <div role="tabpanel" class="tab-pane active" id="html">
                        <pre>&lt;button class="btn btn-default"&gt;Default&lt;/button&gt;</br>&lt;button class="btn btn-primary"&gt;Default&lt;/button&gt; </br>&lt;button class="btn btn-success"&gt;Default&lt;/button&gt;</br>&lt;button class="btn btn-info"&gt;Default&lt;/button&gt;</br>&lt;button class="btn btn-warning"&gt;Default&lt;/button&gt;</br>&lt;button class="btn btn-danger"&gt;Default&lt;/button&gt;                  
                        </pre>
                    </div>
                    <div role="tabpanel" class="tab-pane" id="css">Css</div>
                </div>
            </div>
        </div>
    </div>
</div>