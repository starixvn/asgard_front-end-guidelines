@{
    ViewBag.Title = "Button";
}
<div class="col-sm-12 col-md-6">
    <div class="block">
        <h1 class="block-title">Basic Button</h1>
        <p>Example</p>
        <p>This is the basic set of button</p>
        <ul class="list-unstyled list-inline list-demo">
            <li><button class="btn btn-default">Default</button></li>
            <li><button class="btn btn-primary">Primary</button></li>
            <li><button class="btn btn-success">Success</button></li>
            <li><button class="btn btn-info">Info</button></li>
            <li><button class="btn btn-warning">Warning</button></li>
            <li><button class="btn btn-danger">Danger</button></li>
            <li><button class="btn btn-inverse">Inverse</button></li>
            <li><button class="btn btn-green">Green</button></li>
            <li><button class="btn btn-purple">Purple</button></li>
            <li><button class="btn btn-pink">Pink</button></li>
        </ul>
        <p>Rounded cornners</p>
        <p>Just add <span class="txt-class">".btn-rad"</span> class to the button.</p>
        <ul class="list-unstyled list-inline list-demo">
            <li><button class="btn btn-default btn-rad">Default</button></li>
            <li><button class="btn btn-primary btn-rad">Primary</button></li>
            <li><button class="btn btn-success btn-rad">Success</button></li>
            <li><button class="btn btn-info btn-rad">Info</button></li>
            <li><button class="btn btn-warning btn-rad">Warning</button></li>
            <li><button class="btn btn-danger btn-rad">Danger</button></li>
            <li><button class="btn btn-inverse btn-rad">Inverse</button></li>
            <li><button class="btn btn-green btn-rad">Green</button></li>
            <li><button class="btn btn-purple btn-rad">Purple</button></li>
            <li><button class="btn btn-pink btn-rad">Pink</button></li>
        </ul>
        <p>Transparent Buttons</p>
        <p>Just add <span class="txt-class">".btn-trans"</span> class to the button</p>
        <ul class="list-unstyled list-inline list-demo">
            <li><button class="btn btn-default btn-rad btn-trans">Default</button></li>
