            <li><button class="btn btn-success btn-rad btn-trans">Success</button></li>
            <li><button class="btn btn-info btn-rad btn-trans">Info</button></li>
            <li><button class="btn btn-warning btn-rad btn-trans">Warning</button></li>
            <li><button class="btn btn-danger btn-rad btn-trans">Danger</button></li>
            <li><button class="btn btn-inverse btn-rad btn-trans">Inverse</button></li>
            <li><button class="btn btn-green btn-rad btn-trans">Green</button></li>
            <li><button class="btn btn-purple btn-rad btn-trans">Purple</button></li>
            <li><button class="btn btn-pink btn-rad btn-trans">Pink</button></li>
        </ul>
    </div>
