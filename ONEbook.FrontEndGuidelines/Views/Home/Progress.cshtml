@{
    ViewBag.Title = "Progress";
}

@section css
{
    @Styles.Render("~/bundles/controls/css/progress")
}

<div class="col-sm-12">
    <p>When building web sites and web applications, we often need to provide essential feedback to a user informing them of the progress of their request or task, be it uploading a file, playing a video, or importing data. It is used to view the completion progress of a task.</p>
    <!-- Progress bar -->
    <h2 class="sub-title">Progress bar</h2>
    <p>Provide up-to-date feedback on the progress of a workflow or action with simple yet flexible progress bars.</p>
    <div class="docs-section">
        <div class="btn btn-primary btn-xs withripple view-source">&lt; Source &gt;</div>
        <div class="example-section">
            <h2>Example</h2>
            <div class="demo-section">
                <p>Use some images</p>
                <ul class="list-unstyled list-inline list-images">
                    <li><img src="~/content/CustomizedControls/Images/loading-4.gif" title="Loading" alt="Loading" /></li>
                    <li><img src="~/content/CustomizedControls/Images/loading-5.gif" title="Loading" alt="Loading" /></li>
                    <li><img src="~/content/CustomizedControls/Images/loading-6.gif" title="Loading" alt="Loading" /></li>
                </ul>
                <p>Use Html with CSS3</p>
                <div class="progress">
                    <div class="progress-bar progress-bar-info" style="width: 20%"></div>
                </div>
                <div class="progress progress-striped active">
                    <div style="width: 45%" class="progress-bar"></div>
                </div>
                <div class="spinner">
                    <div class="bar bar1"></div>
                    <div class="bar bar2"></div>
                </div>
            </div>
        </div>
        <div class="code-section">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active"><a href="#progressBarhtml" role="tab" data-toggle="tab">Html</a></li>
                <li role="presentation"><a href="#progressBarLess" role="tab" data-toggle="tab">Less</a></li>
            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="progressBarhtml">
                    <pre class="brush: html">
                        <p>Use some images</p>
                        <ul class="list-unstyled list-inline">
                            <li><img src="~/content/CustomizedControls/Images/loading-4.gif" title="Loading" alt="Loading" /></li>
                            <li><img src="~/content/CustomizedControls/Images/loading-5.gif" title="Loading" alt="Loading" /></li>
                            <li><img src="~/content/CustomizedControls/Images/loading-6.gif" title="Loading" alt="Loading" /></li>
                        </ul>
                        <p>Use Html with CSS3</p>
                        <div class="progress">
                            <div class="progress-bar progress-bar-info" style="width: 20%"></div>
                        </div>
                        <div class="progress progress-striped active">
                            <div style="width: 45%" class="progress-bar"></div>
                        </div>
                        <div class="spinner">
                            <div class="bar bar1"></div>
                            <div class="bar bar2"></div>
                        </div>
                    </pre>
                </div>
                <div role="tabpanel" class="tab-pane" id="progressBarLess">
                    <pre class="brush: css">
                        /********************************************************/
                        /*           Customize the third progress bar           */
                        /********************************************************/
                        
                        .list-images {
                            li {
                                margin: 10px 30px;
                            }
                        }

                        .spinner {
                          position: relative;
                          width: 100%;
                          height: 7px;
                          opacity: 1;
                          background-color: lighten(#8bc34a, 25%);
                          overflow: hidden;

                          .bar {
                            height: 7px;
                            background-color: #8bc34a;
                            position: absolute;
                          }

                          .bar1 {
                            left: 50%;
                            width: 10%;
                            .animation(bar1 7s infinite linear);
                          }

                          .bar2 {
                            left: 0%;
                            width: 0%;
                            .animation(bar2 7s infinite);
                          }
                        }

                        &#64;-webkit-keyframes bar1 {
                            0% { width: 0%; left: 0%; }
                            10% { width: 30%; left: 100%; }
                            19.99% { width: 30%; left: 100%; }
                            20% { width: 0%; left: 0%; }
                            30% { width: 80%; left: 100%; }
                            30.01% { width: 0%; left: 0%; }
                            40% { width: 5%; left: 30%; }
                            50% { width: 50%; left: 100%; }
                            50.01% { width: 0%; left: 0%; }
                            60% { width: 60%; left: 20%; }
                            70% { width: 5%; left: 100%; }
                            70.01% { width: 0%; left: 0%; }
                            80% { width: 50%; left: 30%; }
                            90% { width: 10%; left: 80%; }
                            100% { width: 20%; left: 100%; }
                        }

                        &#64;-moz-keyframes bar1 {
                            0% { width: 0%; left: 0%; }
                            10% { width: 30%; left: 100%; }
                            19.99% { width: 30%; left: 100%; }
                            20% { width: 0%; left: 0%; }
                            30% { width: 80%; left: 100%; }
                            30.01% { width: 0%; left: 0%; }
                            40% { width: 5%; left: 30%; }
                            50% { width: 50%; left: 100%; }
                            50.01% { width: 0%; left: 0%; }
                            60% { width: 60%; left: 20%; }
                            70% { width: 5%; left: 100%; }
                            70.01% { width: 0%; left: 0%; }
                            80% { width: 50%; left: 30%; }
                            90% { width: 10%; left: 80%; }
                            100% { width: 20%; left: 100%; }
                        }

                        &#64;-o-keyframes bar1 {
                            0% { width: 0%; left: 0%; }
                            10% { width: 30%; left: 100%; }
                            19.99% { width: 30%; left: 100%; }
                            20% { width: 0%; left: 0%; }
                            30% { width: 80%; left: 100%; }
                            30.01% { width: 0%; left: 0%; }
                            40% { width: 5%; left: 30%; }
                            50% { width: 50%; left: 100%; }
                            50.01% { width: 0%; left: 0%; }
                            60% { width: 60%; left: 20%; }
                            70% { width: 5%; left: 100%; }
                            70.01% { width: 0%; left: 0%; }
                            80% { width: 50%; left: 30%; }
                            90% { width: 10%; left: 80%; }
                            100% { width: 20%; left: 100%; }
                        }

                        &#64;-ms-keyframes bar1 {
                            0% { width: 0%; left: 0%; }
                            10% { width: 30%; left: 100%; }
                            19.99% { width: 30%; left: 100%; }
                            20% { width: 0%; left: 0%; }
                            30% { width: 80%; left: 100%; }
                            30.01% { width: 0%; left: 0%; }
                            40% { width: 5%; left: 30%; }
                            50% { width: 50%; left: 100%; }
                            50.01% { width: 0%; left: 0%; }
                            60% { width: 60%; left: 20%; }
                            70% { width: 5%; left: 100%; }
                            70.01% { width: 0%; left: 0%; }
                            80% { width: 50%; left: 30%; }
                            90% { width: 10%; left: 80%; }
                            100% { width: 20%; left: 100%; }
                        }

                        &#64;-webkit-keyframes bar2 {
                            0% { width: 0%; left: 0%; }
                            10% { width: 60%; }
                            19.99% { width: 40%; left: 100%; }
                            20% { width: 0%; left: 0%; }
                            25% { width: 10%; left: 10%; }
                            30% { width: 40%; left: 30%; }
                            40% { width: 60%; left: 100%; }
                            40.01% { width: 0%; left: 0%; }
                            50% { width: 10%; left: 40%; }
                            60% { width: 30%; left: 100%; }
                            60.01% { width: 0%; left: 0%; }
                            70% { width: 10%; left: 40%; }
                            80% { width: 5%; left: 100%; }
                            80.01% { width: 0%; left: 0%; }
                            90% { width: 70%; left: 10%; }
                            100% { width: 10%; left: 100%; }
                        }

                        &#64;-moz-keyframes bar2 {
                            0% { width: 0%; left: 0%; }
                            10% { width: 60%; }
                            19.99% { width: 40%; left: 100%; }
                            20% { width: 0%; left: 0%; }
                            25% { width: 10%; left: 10%; }
                            30% { width: 40%; left: 30%; }
                            40% { width: 60%; left: 100%; }
                            40.01% { width: 0%; left: 0%; }
                            50% { width: 10%; left: 40%; }
                            60% { width: 30%; left: 100%; }
                            60.01% { width: 0%; left: 0%; }
                            70% { width: 10%; left: 40%; }
                            80% { width: 5%; left: 100%; }
                            80.01% { width: 0%; left: 0%; }
                            90% { width: 70%; left: 10%; }
                            100% { width: 10%; left: 100%; }
                        }

                        &#64;-o-keyframes bar2 {
                            0% { width: 0%; left: 0%; }
                            10% { width: 60%; }
                            19.99% { width: 40%; left: 100%; }
                            20% { width: 0%; left: 0%; }
                            25% { width: 10%; left: 10%; }
                            30% { width: 40%; left: 30%; }
                            40% { width: 60%; left: 100%; }
                            40.01% { width: 0%; left: 0%; }
                            50% { width: 10%; left: 40%; }
                            60% { width: 30%; left: 100%; }
                            60.01% { width: 0%; left: 0%; }
                            70% { width: 10%; left: 40%; }
                            80% { width: 5%; left: 100%; }
                            80.01% { width: 0%; left: 0%; }
                            90% { width: 70%; left: 10%; }
                            100% { width: 10%; left: 100%; }
                        }

                        &#64;-ms-keyframes bar2 {
                            0% { width: 0%; left: 0%; }
                            10% { width: 60%; }
                            19.99% { width: 40%; left: 100%; }
                            20% { width: 0%; left: 0%; }
                            25% { width: 10%; left: 10%; }
                            30% { width: 40%; left: 30%; }
                            40% { width: 60%; left: 100%; }
                            40.01% { width: 0%; left: 0%; }
                            50% { width: 10%; left: 40%; }
                            60% { width: 30%; left: 100%; }
                            60.01% { width: 0%; left: 0%; }
                            70% { width: 10%; left: 40%; }
                            80% { width: 5%; left: 100%; }
                            80.01% { width: 0%; left: 0%; }
                            90% { width: 70%; left: 10%; }
                            100% { width: 10%; left: 100%; }
                        }
                    </pre>
                </div>
            </div>
        </div>
    </div>
    <!-- Progress circular -->
    <h2 class="sub-title">Progress circular</h2>
    <p>Circular Progress Display is good style to show the progress for loading a website or waiting the response from server.</p>
    <div class="bs-callout bs-callout-info">
        <p>We can use image to display progress circles or use some plugins</p>
    </div>
    <div class="docs-section">
        <div class="btn btn-primary btn-xs withripple view-source">&lt; Source &gt;</div>
        <div class="example-section">
            <h2>Example</h2>
            <div class="demo-section row">
                <div class="col-sm-12">
                    <p>Use some images</p>
                    <ul class="list-unstyled list-inline list-images">
                        <li><img src="~/content/CustomizedControls/Images/loading-1.gif" title="Loading" alt="Loading" /></li>
                        <li><img src="~/content/CustomizedControls/Images/loading-2.gif" title="Loading" alt="Loading" /></li>
                        <li><img src="~/content/CustomizedControls/Images/loading-3.gif" title="Loading" alt="Loading" /></li>
                    </ul>
                </div>
                <div class="col-sm-12">
                    <p>Use <a href="https://github.com/pguso/jquery-plugin-circliful">jquery-plugin-circliful</a> plugin</p>
                    <div id="circular" data-dimension="150" data-text="35%" data-info="New Clients" data-width="20"
                         data-fontsize="15" data-percent="35" data-fgcolor="#61a9dc" data-bgcolor="#eee" data-fill="#ddd"
                         data-total="150" data-part="35" data-icon="long-arrow-up" data-icon-size="18" data-icon-color="#fff"></div>
                </div>
            </div>
        </div>
        <div class="code-section">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active"><a href="#circularProgressHtml" role="tab" data-toggle="tab">Html</a></li>
                <li role="presentation"><a href="#circularProgressLess" role="tab" data-toggle="tab">Less</a></li>
            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="circularProgressHtml">
                    <pre class="brush: html">
                        <div class="col-sm-12">
                            <p>Use some images</p>
                            <ul class="list-unstyled list-inline list-images">
                                <li><img src="~/content/CustomizedControls/Images/loading-1.gif" title="Loading" alt="Loading" /></li>
                                <li><img src="~/content/CustomizedControls/Images/loading-2.gif" title="Loading" alt="Loading" /></li>
                                <li><img src="~/content/CustomizedControls/Images/loading-3.gif" title="Loading" alt="Loading" /></li>
                            </ul>
                        </div>
                        <div class="col-sm-12">
                            <p>Use <a href="https://github.com/pguso/jquery-plugin-circliful">jquery-plugin-circliful</a> plugin</p>
                            <div id="circular" data-dimension="150" data-text="35%" data-info="New Clients" data-width="20"
                                    data-fontsize="15" data-percent="35" data-fgcolor="#61a9dc" data-bgcolor="#eee" data-fill="#ddd"
                                    data-total="150" data-part="35" data-icon="long-arrow-up" data-icon-size="18" data-icon-color="#fff"></div>
                        </div>
                    </pre>
                </div>
                <div role="tabpanel" class="tab-pane" id="circularProgressLess">
                    <pre class="brush: css">
                        .list-images {
                            li {
                                margin: 10px 30px;
                            }
                        }
                    </pre>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    @Scripts.Render("~/bundles/controls/js/progress")
}
