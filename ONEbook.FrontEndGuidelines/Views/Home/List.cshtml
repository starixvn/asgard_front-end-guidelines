@{
    ViewBag.Title = "List";
}
<div class="col-sm-12">
    <p>Lists can be styled further, and images can be used as the list item marker. There are two types of lists:</p>
    <ul>
        <li>unordered list - <span class="text-info">the list items are marked with bullets</span></li>
        <li>ordered list - <span class="text-info">the list items are marked with numbers or letters</span></li>
    </ul>
    <!-- Ordered List -->
    <h2 class="sub-title">Ordered List</h2>
    <p>A list of items in which the order does explicitly matter.</p>
    <div class="docs-section">
        <div class="btn btn-primary btn-xs withripple view-source">&lt; Source &gt;</div>
        <div class="example-section">
            <h2>Example</h2>
            <div class="demo-section">
                <ol>
                    <li>Lorem ipsum dolor sit amet</li>
                    <li>Consectetur adipiscing elit</li>
                    <li>Integer molestie lorem at massa</li>
                    <li>Facilisis in pretium nisl aliquet</li>
                    <li>Nulla volutpat aliquam velit</li>
                </ol>
            </div>
        </div>
        <div class="code-section">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active"><a href="#orderedHtml" role="tab" data-toggle="tab">Html</a></li>
            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="orderedHtml">
                    <pre class="brush: html">
                        <ol>
                            <li>Lorem ipsum dolor sit amet</li>
                            <li>Consectetur adipiscing elit</li>
                            <li>Integer molestie lorem at massa</li>
                            <li>Facilisis in pretium nisl aliquet</li>
                            <li>Nulla volutpat aliquam velit</li>
                        </ol>
                    </pre>
                </div>
            </div>
        </div>
    </div>
