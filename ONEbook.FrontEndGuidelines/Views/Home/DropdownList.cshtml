    <div class="docs-section">
        <div class="btn btn-primary btn-xs withripple view-source">&lt; Source &gt;</div>
        <div class="example-section">
            <h2>Example</h2>
            <div class="demo-section">
                <select id="select-item-template">
                    <optgroup label="Alaskan/Hawaiian Time Zone">
                        <option value="AK">Alaska</option>
                        <option value="HI">Hawaii</option>
                    </optgroup>
                    <optgroup label="Pacific Time Zone">
                        <option value="CA">California</option>
                        <option value="NV">Nevada</option>
                    </optgroup>
                    <optgroup label="Mountain Time Zone">
                        <option value="AZ">Arizona</option>
                        <option value="CO">Colorado</option>
                        <option value="ID">Idaho</option>
                    </optgroup>
                </select>
            </div>
        </div>
        <div class="code-section">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active"><a href="#html-item-template" role="tab" data-toggle="tab">Html</a></li>
                <li role="presentation"><a href="#javascript-item-template" role="tab" data-toggle="tab">JavaScript</a></li>
            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="html-item-template">
                    <pre class="brush: html">
                        <select class="select2-custom" id="select-item-template">
                            <optgroup label="Alaskan/Hawaiian Time Zone">
                            <option value="AK">Alaska</option>
                            <option value="HI">Hawaii</option>
                                </optgroup>
                            <optgroup label="Pacific Time Zone">
                            <option value="CA">California</option>
                            <option value="NV">Nevada</option>
                                </optgroup>
                            <optgroup label="Mountain Time Zone">
                            <option value="AZ">Arizona</option>
                            <option value="CO">Colorado</option>
                            <option value="ID">Idaho</option>
                            </optgroup>
                        </select>
                    </pre>
                </div>
                <div role="tabpanel" class="tab-pane" id="javascript-item-template">
                    <pre class="brush: javascript">
                        function format(state) {
                            if (!state.id) return state.text; // optgroup
                            return "&lt;img class='flag' src='imagelink' /&gt;" + state.text;
                        }

                        $(function () {
                            $("#select-item-template").select2({
                                formatResult: format,
                                formatSelection: format,
                                escapeMarkup: function (m) { return m; }
                            });
                        });
                    </pre>
                </div>
            </div>
        </div>
    </div>

    <!-- Initiate items by list object -->
    <h2 class="sub-title">Initiate dropdown list by list object.</h2>
    <p>We use <a href="https://github.com/ivaynberg/select2" target="_blank">Select2</a> to initiating dropdown list by list object.</p>
    <div class="docs-section">
        <div class="btn btn-primary btn-xs withripple view-source">&lt; Source &gt;</div>
        <div class="example-section">
            <h2>Example</h2>
            <div class="demo-section">
                <div id="select-list-item"></div>
            </div>
        </div>
        <div class="code-section">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active"><a href="#html-list-item" role="tab" data-toggle="tab">Html</a></li>
                <li role="presentation"><a href="#javascript-list-item" role="tab" data-toggle="tab">JavaScript</a></li>
            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="html-list-item">
                    <pre class="brush: html">
                        <select id="select-list-item"></select>
                    </pre>
                </div>
                <div role="tabpanel" class="tab-pane" id="javascript-list-item">
                    <pre class="brush: javascript">
                            var listItem = {
                                results: [
                                    {
                                        id: 11, text: "First Group", children: [
                                          { id: 1, text: "First Item" },
                                          { id: 2, text: "Second Disabled Item", disabled: true },
                                          { id: 3, text: "Third Item" }
                                        ],
                                    },
                                    {
                                        id: 22, text: "Second Group",
                                        children: [
                                          { id: 4, text: "Fourth Disabled Item", disabled: true },
                                          { id: 5, text: "Fifth Item" },
                                          { id: 6, text: "Sixth Item" }
                                        ]
                                    }
                                ]
                            };
                            $('#select-list-item').select2({
                                query: function (query) {
                                    query.callback(listItem);
                                }
                            }).select2("data", { id: 3, text: "Third Item" });
                    </pre>
                </div>
            </div>
        </div>
    </div>

    <!-- Lazy loading item -->
    <h2 class="sub-title">Lazy loading item and virtual scroller.</h2>
    <p>We use <a href="https://github.com/ivaynberg/select2" target="_blank">Select2</a> for lazy loading items and virtual scroller.</p>
    <div class="docs-section">
        <div class="btn btn-primary btn-xs withripple view-source">&lt; Source &gt;</div>
        <div class="example-section">
            <h2>Example</h2>
            <div class="demo-section">
                <div id="select-lazy-load-item"></div>
            </div>
        </div>
        <div class="code-section">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active"><a href="#html-lazy-load-item" role="tab" data-toggle="tab">Html</a></li>
                <li role="presentation"><a href="#javascript-lazy-load-item" role="tab" data-toggle="tab">JavaScript</a></li>
                <li role="presentation"><a href="#csharp-lazy-load-item" role="tab" data-toggle="tab">C#</a></li>
            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="html-lazy-load-item">
                    <pre class="brush: html">
                        <div id="select-lazy-load-item"></div>
                    </pre>
                </div>
                <div role="tabpanel" class="tab-pane" id="javascript-lazy-load-item">
                    <pre class="brush: javascript">
                        $("#select-lazy-load-item").select2({
                            placeholder: "Search for a item",
                            minimumInputLength: 1,
                            ajax: {
                                url: ONEbook.FrontEndGuidelines.rootUrl + 'Home/GetDropdownListData',
                                dataType: 'json',
                                quietMillis: 250,
                                data: function (term, page) { // page is the one-based page number tracked by Select2
                                    return {
                                        searchText: term, //search term
                                        pageNumber: page // page number
                                    };
                                },
                                results: function (data, page) {
                                    var more = (page * 30) < data.Total; // whether or not there are more results available
                                    // notice we return the value of more so Select2 knows if more results can be loaded
                                    var convertedItems = [];
                                    for (var i = 0; i < data.Items.length; i++) {
                                        convertedItems.push({
                                            id: data.Items[i],
                                            text: data.Items[i]
                                        });
                                    }
                                    return { results: convertedItems, more: more };
                                }
                            },
                            formatResult: function (item) {
                                var markup = '&lt;div&gt;' + item.text + '&lt;/div&gt;';
                                return markup;
                            }, // omitted for brevity, see the source of this page
                            formatSelection: function (item) {
                                return item.text;
                            }, // omitted for brevity, see the source of this page
                            dropdownCssClass: "bigdrop", // apply css that makes the dropdown taller
                            escapeMarkup: function (m) { return m; }, // we do not want to escape markup since we are displaying html in results
                            width: "300"
                        });
                    </pre>
                </div>
                <div role="tabpanel" class="tab-pane" id="csharp-lazy-load-item">
                    <pre class="brush: csharp">
                        [HttpGet]
                        public JsonResult GetDropdownListData(string searchText, int pageNumber)
                        {
                            List&lt;string&gt; sampleItems = new List&lt;string&gt;();
                            int pageLength = 30;
                            int totalItem = 1000;
                            int startIndex = pageLength * (pageNumber - 1);
                            int endIndex = Math.Min(startIndex + pageLength, totalItem);
                            for (int i = startIndex; i < endIndex; i++)
                            {
                                sampleItems.Add(searchText + i.ToString());
                            }
                            return Json(
                                new
                                {
                                    Total = totalItem,
                                    Items = sampleItems,
                                }, JsonRequestBehavior.AllowGet);
                        }
                    </pre>
                </div>
            </div>
        </div>
    </div>

