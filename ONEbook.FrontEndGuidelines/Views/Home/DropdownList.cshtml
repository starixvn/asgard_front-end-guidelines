@{
    ViewBag.Title = "Dropdown List";
}

@section css
{
    @Styles.Render("~/bundles/controls/css/dropdownlist")
}

@section scripts
{
    @Scripts.Render("~/bundles/controls/js/dropdownlist")
    <script type="text/javascript">
        $(function () {
            $('#default-select').select2();
        });
    </script>
}

<div class="col-sm-12">
    <p>Support select single or multiple items from list item.</p>

    <!-- Default dropdownlist -->
    <h2 class="sub-title">Default Dropdown List </h2>
    <p>We use <a href="https://github.com/ivaynberg/select2" target="_blank">Select2</a> plugin for rendering dropdown list. This is the default option, it converts from select element to select2 plugin. By default config select2 provided:</p>
    <ul>
        <li>Shows all items linearly as the native dropdown list.</li>
        <li>Shows search box for choosing item quickly.</li>
    </ul>
    <div class="docs-section">
        <div class="btn btn-primary btn-xs withripple view-source">&lt; Source &gt;</div>
        <div class="example-section">
            <h2>Example</h2>
            <div class="demo-section">
                <div>
                    <span>Select2 Select2 can take a regular select box like this: </span>
                </div>
                <div>
                    <select style="width:300px" id="default-select-native">
                        <optgroup label="Alaskan/Hawaiian Time Zone">
                            <option value="AK">Alaska</option>
                            <option value="HI">Hawaii</option>
                        </optgroup>
                        <optgroup label="Pacific Time Zone">
                            <option value="CA">California</option>
                            <option value="NV">Nevada</option>
                            <option value="OR">Oregon</option>
                            <option value="WA">Washington</option>
                        </optgroup>
                        <optgroup label="Mountain Time Zone">
                            <option value="AZ">Arizona</option>
                            <option value="CO">Colorado</option>
                            <option value="ID">Idaho</option>
                            <option value="MT">Montana</option>
                            <option value="NE">Nebraska</option>
                            <option value="NM">New Mexico</option>
                            <option value="ND">North Dakota</option>
                            <option value="UT">Utah</option>
                            <option value="WY">Wyoming</option>
                        </optgroup>
                    </select>
                </div>
                <div>
                    <span>and turns it into: </span>
                </div>
                <div>
                    <select style="width:300px" id="default-select">
                        <optgroup label="Alaskan/Hawaiian Time Zone">
                            <option value="AK">Alaska</option>
                            <option value="HI">Hawaii</option>
                        </optgroup>
                        <optgroup label="Pacific Time Zone">
                            <option value="CA">California</option>
                            <option value="NV">Nevada</option>
                            <option value="OR">Oregon</option>
                            <option value="WA">Washington</option>
                        </optgroup>
                        <optgroup label="Mountain Time Zone">
                            <option value="AZ">Arizona</option>
                            <option value="CO">Colorado</option>
                            <option value="ID">Idaho</option>
                            <option value="MT">Montana</option>
                            <option value="NE">Nebraska</option>
                            <option value="NM">New Mexico</option>
                            <option value="ND">North Dakota</option>
                            <option value="UT">Utah</option>
                            <option value="WY">Wyoming</option>
                        </optgroup>
                    </select>
                </div>
            </div>
        </div>
        <div class="code-section">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active"><a href="#html" role="tab" data-toggle="tab">Html</a></li>
                <li role="presentation"><a href="#javascript" role="tab" data-toggle="tab">JavaScript</a></li>
            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="html">
                    <pre class="brush: html">
                        <select id="default-select">
                            <optgroup label="Alaskan/Hawaiian Time Zone">
                                <option value="AK">Alaska</option>
                                <option value="HI">Hawaii</option>
                            </optgroup>
                                <optgroup label="Pacific Time Zone">
                                <option value="CA">California</option>
                                <option value="NV">Nevada</option>
                                ...
                            </optgroup>
                        </select>
                    </pre>
                </div>
                <div role="tabpanel" class="tab-pane" id="javascript">
                    <pre class="brush: javascript">
                        $(function () {
                            $('#default-select').select2();
                        });
                    </pre>
                </div>
            </div>
        </div>
    </div>
</div>