@{
    ViewBag.Title = "Dialog";
}

@section css
{
    @Styles.Render("~/bundles/controls/css/dialog")
}

@section scripts
{
    @Scripts.Render("~/bundles/controls/js/dialog")
}

<div class="col-sm-12">
    <p>We use <a href="https://github.com/nakupanda/bootstrap3-dialog" target="_blank">bootstrap3-dialog</a> plugin to uake use of Bootstrap Modal more monkey-friendly.</p>

    <p>
        Some scenarios <a href="https://github.com/nakupanda/bootstrap3-dialog" target="_blank">bootstrap3-dialog</a> can be applied are:
        <ul>
            <li><a href="#showModal">Show bootstrap modal simplest way.</a></li>
            <li><a href="#modifyDialogWhenOpening">Modify Dialog Content when is opening.</a></li>
            <li><a href="#controlDialogInstances">Control dialog instances.</a></li>
            <li><a href="#dialogEvents">Using dialog events to do actions before dialog showed or closed..</a></li>
        </ul>
    </p>
    <!-- Do bootstrap modal simplest way. -->
    <h2 class="sub-title" id="showModal">Show bootstrap modal simplest way.</h2>
    <div class="docs-section">
        <div class="btn btn-primary btn-xs withripple view-source">&lt; Source &gt;</div>
        <div class="example-section">
            <h2>Example</h2>
            <div class="demo-section">
                <button class="btn btn-primary" id="btn-dialog-default">Open dialog</button>
            </div>
        </div>
        <div class="code-section">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active"><a href="#html-dialog-default" role="tab" data-toggle="tab">Html</a></li>
                <li role="presentation"><a href="#javascript-dialog-default" role="tab" data-toggle="tab">JavaScript</a></li>
            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="html-dialog-default">
                    <pre class="brush: html">
                        <button class="btn btn-primary" id="btn-dialog-default">Open dialog</button>
                    </pre>
                </div>
                <div role="tabpanel" class="tab-pane" id="javascript-dialog-default">
                    <pre class="brush: javascript">
                        $('#btn-dialog-default').click(function () {
                            BootstrapDialog.show({
                                message: 'Hi!'
                            });
                        });
                    </pre>
                </div>
            </div>
        </div>
    </div>


    <!-- Modify Dialog Content -->
    <h2 class="sub-title" id="modifyDialogWhenOpening">Modify Dialog Content when is opening.</h2>
    <p></p>
    <div class="bs-callout bs-callout-info">
        With bootstrap3-dialog, we can modify:
        <ul>
            <li>Dialog Title</li>
            <li>Dialog Buttons</li>
            <li>Dialog Message</li>
        </ul>
    </div>
    <div class="docs-section">
        <div class="btn btn-primary btn-xs withripple view-source">&lt; Source &gt;</div>
        <div class="example-section">
            <h2>Example</h2>
            <div class="demo-section">
                <button class="btn btn-primary" id="btn-dialog-modify">Open dialog for modifying.</button>
            </div>
        </div>
        <div class="code-section">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active"><a href="#html-dialog-modify" role="tab" data-toggle="tab">Html</a></li>
                <li role="presentation"><a href="#javascript-dialog-modify" role="tab" data-toggle="tab">JavaScript</a></li>
            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="html-dialog-modify">
                    <pre class="brush: html">
                        <button class="btn btn-primary" id="btn-dialog-modify">Open dialog for modifying.</button>
                    </pre>
                </div>
                <div role="tabpanel" class="tab-pane" id="javascript-dialog-modify">
                    <pre class="brush: javascript">
                        $('#btn-dialog-modify').click(function () {
                            BootstrapDialog.show({
                                title: 'Default Title',
                                message: 'Click buttons below.',
                                buttons: [{
                                    label: 'Modify 1',
                                    hotkey: 65, // Keycode of keyup event of key 'A' is 65.
                                    cssClass: 'btn-primary',
                                    action: function (dialog) {
                                        dialog.setTitle('Title 1');
                                        dialog.setMessage('Message 1');
                                    }
                                }, {
                                    label: 'Modify 2',
                                    hotkey: 66,
                                    cssClass: 'btn-success',
                                    action: function (dialog) {
                                        dialog.setTitle('Title 2');
                                        dialog.setMessage('Message 2');
                                    }
                                }, {
                                    icon: 'glyphicon glyphicon-ban-circle',
                                    label: 'Disable myself',
                                    cssClass: 'btn-warning',
                                    action: function (dialog) {
                                        var $button = this; // 'this' here is a jQuery object that wrapping the &lt;button&gt; DOM element.
                                        $button.disable();
                                    }
                                }, {
                                    label: 'Close',
                                    cssClass: 'btn-danger',
                                    action: function (dialogItself) {
                                        dialogItself.close();
                                    }
                                }]
                            });
                        });
                    </pre>
                </div>
            </div>
        </div>
    </div>

    <!-- Control dialog instances -->
    <h2 class="sub-title" id="controlDialogInstances">Control dialog instances.</h2>
    <div class="bs-callout bs-callout-info">
        BootstrapDialog.show(...) is just a shortcut method, if you need dialog instances, use 'new'.
    </div>
    <div class="docs-section">
        <div class="btn btn-primary btn-xs withripple view-source">&lt; Source &gt;</div>
        <div class="example-section">
            <h2>Example</h2>
            <div class="demo-section">
                <button class="btn btn-primary" id="btn-dialog-instances">Open multiple dialogs.</button>
            </div>
        </div>
        <div class="code-section">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active"><a href="#html-dialog-instances" role="tab" data-toggle="tab">Html</a></li>
                <li role="presentation"><a href="#javascript-dialog-instances" role="tab" data-toggle="tab">JavaScript</a></li>
            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="html-dialog-instances">
                    <pre class="brush: html">
                        <button class="btn btn-primary" id="btn-dialog-instances">Open multiple dialogs.</button>
                    </pre>
                </div>
                <div role="tabpanel" class="tab-pane" id="javascript-dialog-instances">
                    <pre class="brush: javascript">
                        // Using init options
                        var dialogInstance1 = new BootstrapDialog({
                            title: 'Dialog instance 1',
                            message: 'Hi Apple!'
                        });


                        // Construct by using setters
                        var dialogInstance2 = new BootstrapDialog();
                        dialogInstance2.setTitle('Dialog instance 2');
                        dialogInstance2.setMessage('Hi Orange!');
                        dialogInstance2.setType(BootstrapDialog.TYPE_SUCCESS);


                        // Using chain callings
                        var dialogInstance3 = new BootstrapDialog()
                            .setTitle('Dialog instance 3')
                            .setMessage('Hi Everybody!')
                            .setType(BootstrapDialog.TYPE_INFO);

                        dialogInstance1.open();
                        dialogInstance2.open();
                        dialogInstance3.open();

                    </pre>
                </div>
            </div>
        </div>
    </div>

    <!-- Dialog events -->
    <h2 class="sub-title" id="dialogEvents">Dialog events.</h2>
    <div class="bs-callout bs-callout-info">
        Using dialog events to do actions before dialog showed or closed.
    </div>
    <div class="docs-section">
        <div class="btn btn-primary btn-xs withripple view-source">&lt; Source &gt;</div>
        <div class="example-section">
            <h2>Example</h2>
            <div class="demo-section">
                <button class="btn btn-primary" id="btn-dialog-events">Open dialog and show events.</button>
            </div>
        </div>
        <div class="code-section">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active"><a href="#html-dialog-events" role="tab" data-toggle="tab">Html</a></li>
                <li role="presentation"><a href="#javascript-dialog-events" role="tab" data-toggle="tab">JavaScript</a></li>
            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="html-dialog-events">
                    <pre class="brush: html">
                    </pre>
                </div>
                <div role="tabpanel" class="tab-pane" id="javascript-dialog-events">
                    <pre class="brush: javascript">
                    </pre>
                </div>
            </div>
        </div>
    </div>
</div>
