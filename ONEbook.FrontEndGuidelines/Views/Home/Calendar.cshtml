    <!-- Select a month -->
    <h2 id="hdSelectMonthYear" class="sub-title">Select month and year only</h2>
    <p>
        This example shows how to cutomize <a href="http://eonasdan.github.io/bootstrap-datetimepicker/" target="_blank">Bootstrap DateTime picker</a>
        to allow the user to select month and year only.
    </p>
    <div class="docs-section">
        <div class="btn btn-primary btn-xs withripple view-source">&lt; Source &gt;</div>
        <div class="example-section">
            <h2>Example</h2>
            <div class="demo-section row">
                <div class="col-sm-3">
                    <div class="form-group">
                        <label for="dpkMonth" class="control-label">Month</label>
                        <div class="input-group" id="dpkMonth">
                            <input type="text" class="form-control" placeholder="Pick a month" />
                            <span class="input-group-addon">
                                <span class="glyphicon glyphicon-calendar"></span>
                            </span>
                        </div>
                    </div>
                </div>
