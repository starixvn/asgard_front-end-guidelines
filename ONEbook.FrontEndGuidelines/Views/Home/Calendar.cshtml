@{
    ViewBag.Title = "Calendar";
}
@section css
{
    @Styles.Render("~/bundles/controls/css/calendar")
}
<div class="col-sm-12">
    <p>
        Provide a friendlier UI than a classic textbox to support the user to pick a date, a month, a date range or a month range for updating or querying data purposes.
        For this type of requirements, we will mainly use <a href="http://eonasdan.github.io/bootstrap-datetimepicker/" target="_blank">Bootstrap DateTime picker</a> with <a href="http://momentjs.com/" target="_blank">moment</a>
        with some addtional JavaScript codes for some special cases.
    </p>
    <p>
        Some scenarios <a href="http://eonasdan.github.io/bootstrap-datetimepicker/" target="_blank">Bootstrap DateTime picker</a> can be applied are:
        <ul>
            <li><a href="#hdSingleDateTimePicker">Pick a single date</a></li>
            <li><a href="#hdSelectDateRange">Select a date range</a></li>
            <li><a href="#hdQuickDateRange">Quickly select a defined date range</a></li>
            <li><a href="#hdSelectMonthYear">Select month and year only</a></li>
            <li><a href="#hdSelectMonthRange">Select s month range</a></li>
        </ul>
    </p>
    <!-- Simple DateTime picker -->
    <h2 id="hdSingleDateTimePicker" class="sub-title">Single DateTime picker</h2>
    <p>
        The following example shows how to configure <a href="http://eonasdan.github.io/bootstrap-datetimepicker/" target="_blank">Bootstrap DateTime picker</a>
        to satisfy some common cases in a real project:
        <ul>
            <li>Pick any date.</li>
            <li>Sets a default date, accept JavaScript dates, strings and <a href="http://momentjs.com/" target="_blank">moment</a> objects.</li>
            <li>Select a date which must be in a given range.</li>
            <li>Show the date picker in a specific language.</li>
            <li>Show, hide, enable, disable the control programmatically.</li>
        </ul>
    </p>
    <div class="bs-callout bs-callout-warning">
        <h4>Note</h4>
        <p>
            When you change the language of the DateTime picker, it needs to repaint the control.
            Due to the performance issue of creating new DateTime picker, you should decide which language will be displayed when initializing the control
            , or you must destroy it programmatically and create it again.
        </p>
    </div>
    <div class="docs-section">
        <div class="btn btn-primary btn-xs withripple view-source">&lt; Source &gt;</div>
        <div class="example-section">
            <h2>Example</h2>
            <div class="demo-section row">
                <div class="col-md-7">
                    <div class="form-group col-sm-10">
                        <label for="dpkSamepleDate" class="control-label">Date</label>
                        <div class="input-group" id="dpkSamepleDate">
                            <input type="text" class="form-control" placeholder="Pick a date" />
                            <span class="input-group-addon">
                                <span class="glyphicon glyphicon-calendar"></span>
                            </span>
                        </div>
                    </div>
                    <div class="form-group">
                        <button class="btn btn-primary" type="button" id="btnShowSampleDate">Show</button>
                        <button class="btn btn-primary" type="button" id="btnHideSampleDate">Hide</button>
                        <button class="btn btn-primary" type="button" id="btnEnableSampleDate">Enable</button>
                        <button class="btn btn-primary" type="button" id="btnDisableSampleDate">Disable</button>
                    </div>
                </div>
                <div class="col-md-5 calendar-form">
                    <div class="form-group">
                        <label class="control-label">Min Date</label>
                        <div class="row">
                            <div class=" col-sm-6">
                                <input type="text" id="txtMinDate" class="form-control" placeholder="mm/dd/yyyy"/>
                            </div>
                            <div class="col-sm-6">
                                <button class="btn btn-primary" type="button" id="btnSetMinDate">Set Min Date</button>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Max Date</label>
                        <div class="row">
                            <div class=" col-sm-6">
                                <input type="text" id="txtMaxDate" class="form-control" placeholder="mm/dd/yyyy" />
                            </div>
                            <div class="col-sm-6">
                                <button class="btn btn-primary" type="button" id="btnSetMaxDate">Set Max Date</button>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="control-label">Language</label>
                        <div class="row">
                            <div class=" col-sm-6">
                                <select id="ddlLanguage" class="form-control">
                                    <option value="en">English</option>
                                    <option value="zh-cn">Simplified Chinese</option>
                                    <option value="zh-tw">Traditional Chinese</option>
                                </select>
                            </div>
                            <div class="col-sm-6">
                                <button class="btn btn-primary" type="button" id="btnSetLanguage">Set Language</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="code-section">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active"><a href="#singleDatepickerHtml" role="tab" data-toggle="tab">Html</a></li>
                <li role="presentation"><a href="#singleDatepickerJavascript" role="tab" data-toggle="tab">JavaScript</a></li>
            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="singleDatepickerHtml">
                    <pre class="brush: html">
                        <div class="col-md-7">
                            <div class="form-group col-sm-10">
                                <label for="dpkSamepleDate" class="control-label">Date</label>
                                <div class="input-group" id="dpkSamepleDate">
                                    <input type="text" class="form-control" placeholder="Pick a date" />
                                    <span class="input-group-addon">
                                        <span class="glyphicon glyphicon-calendar"></span>
                                    </span>
                                </div>
                            </div>
                            <div class="form-group">
                                <button class="btn btn-primary" type="button" id="btnShowSampleDate">Show</button>
                                <button class="btn btn-primary" type="button" id="btnHideSampleDate">Hide</button>
                                <button class="btn btn-primary" type="button" id="btnEnableSampleDate">Enable</button>
                                <button class="btn btn-primary" type="button" id="btnDisableSampleDate">Disable</button>
                            </div>
                        </div>
                        <div class="col-md-5 calendar-form">
                            <div class="form-group">
                                <label class="control-label">Min Date</label>
                                <div class="row">
                                    <div class=" col-sm-6">
                                        <input type="text" id="txtMinDate" class="form-control" placeholder="mm/dd/yyyy"/>
                                    </div>
                                    <div class="col-sm-6">
                                        <button class="btn btn-primary" type="button" id="btnSetMinDate">Set Min Date</button>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label">Max Date</label>
                                <div class="row">
                                    <div class=" col-sm-6">
                                        <input type="text" id="txtMaxDate" class="form-control" placeholder="mm/dd/yyyy" />
                                    </div>
                                    <div class="col-sm-6">
                                        <button class="btn btn-primary" type="button" id="btnSetMaxDate">Set Max Date</button>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="control-label">Language</label>
                                <div class="row">
                                    <div class=" col-sm-6">
                                        <select id="ddlLanguage" class="form-control">
                                            <option value="en">English</option>
                                            <option value="zh-cn">Simplified Chinese</option>
                                            <option value="zh-tw">Traditional Chinese</option>
                                        </select>
                                    </div>
                                    <div class="col-sm-6">
                                        <button class="btn btn-primary" type="button" id="btnSetLanguage">Set Language</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </pre>
                </div>
                <div role="tabpanel" class="tab-pane" id="singleDatepickerJavascript">
                    <pre class="brush: javascript">
                        /* global Namespace, ONEbook */

                        'use strict';

                        $(document).ready(function () {
                            var calendarPage = new ONEbook.FrontEndGuidelines.Calendar();

                            calendarPage.Initialize();
                        });

                        Namespace.Register('ONEbook.FrontEndGuidelines.Calendar');
                        ONEbook.FrontEndGuidelines.Calendar = function () {
                            var me = this;
                            var cachedDOM = {
                                dpkSamepleDate: null,
                                txtMinDate: null,
                                btnSetMinDate: null,
                                txtMaxDate: null,
                                btnSetMaxDate: null,
                                btnShowSampleDate: null,
                                btnHideSampleDate: null,
                                btnEnableSampleDate: null,
                                btnDisableSampleDate: null,
                                ddlLanguage: null,
                                btnSetLanguage: null
                            };

                            // Cache DOM elements for later uses.
                            var cacheElements = function () {
                                cachedDOM.dpkSamepleDate = $('#dpkSamepleDate');
                                cachedDOM.txtMinDate = $('#txtMinDate');
                                cachedDOM.btnSetMinDate = $('#btnSetMinDate');
                                cachedDOM.txtMaxDate = $('#txtMaxDate');
                                cachedDOM.btnSetMaxDate = $('#btnSetMaxDate');
                                cachedDOM.btnShowSampleDate = $('#btnShowSampleDate');
                                cachedDOM.btnHideSampleDate = $('#btnHideSampleDate');
                                cachedDOM.btnEnableSampleDate = $('#btnEnableSampleDate');
                                cachedDOM.btnDisableSampleDate = $('#btnDisableSampleDate');
                                cachedDOM.ddlLanguage = $('#ddlLanguage');
                                cachedDOM.btnSetLanguage = $('#btnSetLanguage');
                            };

                            // Initialize a simple date picker.
                            var initializeSampleDate = function () {
                                cachedDOM.dpkSamepleDate.datetimepicker({                        
                                    defaultDate: new Date(),
                                    pickTime: false,
                                    useCurrent: false
                                });
                            };

                            // Set minimum date that the datepicker can allow the user to select.
                            var setMinDate = function () {
                                var minDate = cachedDOM.txtMinDate.val();

                                cachedDOM.dpkSamepleDate.data('DateTimePicker').setMinDate(minDate);
                            };

                            // Set maximum date that the datepicker can allow the user to select.
                            var setMaxDate = function () {
                                var maxDate = cachedDOM.txtMaxDate.val();

                                cachedDOM.dpkSamepleDate.data('DateTimePicker').setMaxDate(maxDate);
                            };

                            // Show the datepicker programmatically.
                            var showDatePicker = function () {
                                cachedDOM.dpkSamepleDate.data('DateTimePicker').show();
                            };

                            // Hide the datepicker programmatically.
                            var hideDatePicker = function () {
                                cachedDOM.dpkSamepleDate.data('DateTimePicker').hide();
                            };

                            // Enable the datepicker.
                            var enableDatePicker = function () {
                                cachedDOM.dpkSamepleDate.data('DateTimePicker').enable();
                            };

                            // Disable the datepicker.
                            var disableDatePicker = function () {
                                cachedDOM.dpkSamepleDate.data('DateTimePicker').disable();
                            };

                            // Change the displaying language.
                            var changeLanguage = function () {
                                var language = cachedDOM.ddlLanguage.val();

                                cachedDOM.dpkSamepleDate.data('DateTimePicker').destroy();
                                cachedDOM.dpkSamepleDate.datetimepicker({
                                    language: language,
                                    pickTime: false,
                                    useCurrent: false
                                });
                            }

                            // Register all handlers to events of controls.
                            var registerEvents = function () {
                                cachedDOM.btnSetMinDate.on('click', setMinDate);
                                cachedDOM.btnSetMaxDate.on('click', setMaxDate);
                                cachedDOM.btnShowSampleDate.on('click', showDatePicker);
                                cachedDOM.btnHideSampleDate.on('click', hideDatePicker);
                                cachedDOM.btnEnableSampleDate.on('click', enableDatePicker);
                                cachedDOM.btnDisableSampleDate.on('click', disableDatePicker);
                                cachedDOM.btnSetLanguage.on('click', changeLanguage);
                            };

                            me.Initialize = function () {
                                cacheElements();
                                initializeSampleDate();
                                registerEvents();
                            };
                        };
                    </pre>
                </div>
            </div>
        </div>
    </div>
    <!---------------------------->
    <!-- Select a date range -->
    <h2 id="hdSelectDateRange" class="sub-title">Select a date range</h2>
    <p>
        This example shows how to use two <a href="http://eonasdan.github.io/bootstrap-datetimepicker/">Bootstrap DateTime pickers</a>
        to allow the user to pick a date range.
    </p>
    <div class="docs-section">
        <div class="btn btn-primary btn-xs withripple view-source">&lt; Source &gt;</div>
        <div class="example-section">
            <h2>Example</h2>
            <div class="demo-section row">
                <div class="col-sm-6 col-md-4">
                    <div class="form-group">
                        <label for="dpkFromDate" class="control-label">From Date</label>
                        <div class="input-group" id="dpkFromDate">
                            <input type="text" class="form-control" placeholder="Pick a date" />
                            <span class="input-group-addon">
                                <span class="glyphicon glyphicon-calendar"></span>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-4">
                    <div class="form-group">
                        <label for="dpkToDate" class="control-label">To Date</label>
                        <div class="input-group" id="dpkToDate">
                            <input type="text" class="form-control" placeholder="Pick a date" />
                            <span class="input-group-addon">
                                <span class="glyphicon glyphicon-calendar"></span>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-md-4">
                    <div class="form-group">
                        <button class="btn btn-primary" type="button" id="btnShowDateRange">Show Date Range</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="code-section">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs" role="tablist">
                <li role="presentation" class="active"><a href="#dateRangeHtml" role="tab" data-toggle="tab">Html</a></li>
                <li role="presentation"><a href="#dateRangeJavascript" role="tab" data-toggle="tab">JavaScript</a></li>
            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active" id="dateRangeHtml">
                    <pre class="brush: html">
                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <label for="dpkFromDate" class="control-label">From Date</label>
                                <div class="input-group" id="dpkFromDate">
                                    <input type="text" class="form-control" placeholder="Pick a date" />
                                    <span class="input-group-addon">
                                        <span class="glyphicon glyphicon-calendar"></span>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <label for="dpkToDate" class="control-label">To Date</label>
                                <div class="input-group" id="dpkToDate">
                                    <input type="text" class="form-control" placeholder="Pick a date" />
                                    <span class="input-group-addon">
                                        <span class="glyphicon glyphicon-calendar"></span>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="form-group">
                                <button class="btn btn-primary" type="button" id="btnShowDateRange">Show Date Range</button>
                            </div>
                        </div>
                    </pre>
                </div>
                <div role="tabpanel" class="tab-pane" id="dateRangeJavascript">
                    <pre class="brush: javascript">
                        /* global Namespace, ONEbook */

                        'use strict';
                        $(document).ready(function () {
                            var calendarPage = new ONEbook.FrontEndGuidelines.Calendar();
                            calendarPage.Initialize();
                        });

                        Namespace.Register('ONEbook.FrontEndGuidelines.Calendar');
                        ONEbook.FrontEndGuidelines.Calendar = function () {
                            var me = this;
                            var cachedDOM = {
                                dpkFromDate: null,
                                dpkToDate: null,
                                btnShowDateRange: null
                            };

                            // Cache DOM elements for later uses.
                            var cacheElements = function () {
                                cachedDOM.dpkFromDate = $('#dpkFromDate');
                                cachedDOM.dpkToDate = $('#dpkToDate');
                                cachedDOM.btnShowDateRange = $('#btnShowDateRange');
                            };

                            // Initialize the date range.
                            var initializeDateRange = function () {
                                cachedDOM.dpkFromDate.datetimepicker({
                                    defaultDate: new Date(),
                                    pickTime: false,
                                    useCurrent: false
                                });

                                cachedDOM.dpkToDate.datetimepicker({
                                    defaultDate: new Date(),
                                    pickTime: false,
                                    useCurrent: false
                                });

                                cachedDOM.dpkFromDate.on('dp.change', function (e) {
                                    var currentToDateValue = cachedDOM.dpkToDate.data('DateTimePicker').getDate();

                                    if (currentToDateValue < e.date) {
                                        cachedDOM.dpkToDate.data('DateTimePicker').setDate(e.date);
                                    }

                                    cachedDOM.dpkToDate.data('DateTimePicker').setMinDate(e.date);
                                });

                                cachedDOM.dpkToDate.on('dp.change', function (e) {
                                    var currentFromMonthValue = cachedDOM.dpkFromDate.data('DateTimePicker').getDate();

                                    if (currentFromMonthValue > e.date) {
                                        cachedDOM.dpkFromDate.data('DateTimePicker').setDate(e.date);
                                    }

                                    cachedDOM.dpkFromDate.data('DateTimePicker').setMaxDate(e.date);
                                });
                            };

                            // Initialize pickers to allow to select a date range.
                            var showSelectedDateRange = function () {
                                var dateFrom = cachedDOM.dpkFromDate.data('DateTimePicker').getDate();
                                var dateTo = cachedDOM.dpkToDate.data('DateTimePicker').getDate();
                                alert('Date range: ' + new Date(dateFrom) + ' - ' + new Date(dateTo));
                            };

                            // Register all handlers to events of controls.
                            var registerEvents = function () {
                                cachedDOM.btnShowDateRange.on('click', showSelectedDateRange);
                            };

                            me.Initialize = function () {
                                cacheElements();
                                initializeDateRange();
                                registerEvents();
                            };
                        };
                    </pre>
                </div>
            </div>
        </div>
    </div>
