@{
    var leftMenuViewModel = (LeftMenuViewModel)ViewBag.LeftMenuViewModel;
    var hasLeftMenu = leftMenuViewModel != null && leftMenuViewModel.MenuItems.Any();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Font-End Guidelines</title>
    <link href='http://fonts.googleapis.com/css?family=Roboto' rel='stylesheet' type='text/css'>
    @Styles.Render("~/Content/bootstrap")
    @Styles.Render("~/Content/materialdesign")
    @Styles.Render("~/Content/style")
    @Scripts.Render("~/bundles/modernizr")
    @Styles.Render("~/Content/highlightcss")
    @RenderSection("css", required: false)
</head>
<body>
    @Html.Partial("_TopMenu")
    <div class="content" id="mainContent">
        @if (hasLeftMenu)
        {
            <div class="left-panel">
                <ul class="sub-menu list-unstyled">
                    @foreach (KeyValuePair<string, Tuple<string, bool>> menuItem in leftMenuViewModel.MenuItems)
                    {
                        string cssClasses = leftMenuViewModel.ActiveMenu == menuItem.Key ? "active" : string.Empty;

                        cssClasses += menuItem.Value.Item2 ? string.Empty : " content-not-available";
                        cssClasses += " withripple";

                        <li>
                            @if (menuItem.Key == "DataTable")
                            {
                                <a href="http://116.193.67.120/fanexgrid" target="_blank">@menuItem.Value.Item1</a>
                            }
                            else
                            {
                                @Html.ActionLink(
                                        menuItem.Value.Item1,
                                         leftMenuViewModel.ActionName,
                                         leftMenuViewModel.ControllerName,
                                        new { viewName = menuItem.Key },
                                        new { @class = cssClasses })
                            }
                        </li>
                    }
                    @*<li><a href="http://10.18.200.209:8823/" target="_blank">Grid</a></li>*@
                </ul>
                @if (leftMenuViewModel.MoreInfo)
                {
                    <ul class="info">
                        <li><span class="lbl-importance">***</span> MUST follow</li>
                        <li><span class="lbl-importance">**</span> Strongly Recommend</li>
                        <li><span class="lbl-importance">*</span> Recommend</li>
                    </ul>
                }
            </div>
        }

        <div class="right-panel @(hasLeftMenu ? "show-left" : string.Empty)" id="right-panel">
            <div class="container-fluid" id="right-container">
                <div class="row">
                    <div class="col-sm-12">
                        <h1 class="title">@ViewBag.Title</h1>
                    </div>
                </div>
                <div class="row">
                    @RenderBody()
                    <div class="scroll-top">
                        <span class="mdi-editor-publish icon-scroll-top" id="back-top"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <footer class="footer">
        <p>Front-end team @@ Nexcel Solutions — For internal use only</p>
    </footer>
    @Html.Hidden("FrontEndGuidelinesRootUrl", Url.Content("~/"))
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/materialdesign")
    @Scripts.Render("~/bundles/layoutjs")
    @Scripts.Render("~/bundles/highlightjs")
    @RenderSection("scripts", required: false)
    <script type="text/javascript">
        $(function () {
            $.material.init();
        });
        SyntaxHighlighter.defaults['toolbar'] = false;
        SyntaxHighlighter.all();
    </script>
</body>
</html>