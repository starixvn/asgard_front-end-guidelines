@{
    Dictionary<string, Tuple<string, bool>> webControls = ViewBag.WebControls as Dictionary<string, Tuple<string, bool>>;
    string tabName = (string)ViewBag.TabName;
    bool isWebControl = ViewBag.IsWebControl != null ? (bool)ViewBag.IsWebControl : false;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Font-End Guidelines</title>
    <link href='http://fonts.googleapis.com/css?family=Roboto' rel='stylesheet' type='text/css'>
    @Styles.Render("~/Content/bootstrap")
    @Styles.Render("~/Content/materialdesign")
    @Styles.Render("~/Content/style")
    @Scripts.Render("~/bundles/modernizr")
    @Styles.Render("~/Content/highlightcss")
    @RenderSection("css", required: false)
</head>
<body>
    <header class="header">
        <nav class="navbar" role="navigation">
            <div class="container-fluid">
                <!-- Brand and toggle get grouped for better mobile display -->
                <div class="navbar-header">
                    <a class="logo" href="/">
                        Front-end
                        <span> Guideline</span>
                    </a>
                    <i class="mdi-navigation-menu icon-left-panel withripple" id="toggleMenu"></i>
                </div>
                <!-- Collect the nav links, forms, and other content for toggling -->
                <div class="navbar-collapse" id="bs-example-navbar-collapse-1">
                    <ul class="nav navbar-nav">
                        <li class="@(tabName == "introduction" ? "active" : string.Empty)">@Html.ActionLink("Introduction", "Index", "Home")</li>
                        <li class="@(tabName == "commoncontrols" ? "active" : string.Empty)" id="commonControls">@Html.ActionLink("Common Controls", "CommonControls", "Home")</li>
                        <li class="@(tabName == "htmlrules" ? "active" : string.Empty)">@Html.ActionLink("Html Rules", "HtmlRules", "Home")</li>
                        <li class="@(tabName == "cssrules" ? "active" : string.Empty)">@Html.ActionLink("CSS Rules", "CssRules", "Home")</li>
                        <li class="@(tabName == "javascriptrules" ? "active" : string.Empty)">@Html.ActionLink("JavaScript Rules", "JavaScriptRules", "Home")</li>
                        
                    </ul>
                </div><!-- /.navbar-collapse -->
            </div><!-- /.container-fluid -->
        </nav>
        <i class="logo"></i>
    </header>
    <div class="content" id="mainContent">
        <div class="left-panel">
            <ul class="sub-menu list-unstyled">
                @foreach (var control in webControls)
                {
                    string cssClasses = tabName == control.Key ? "active" : string.Empty;

                    cssClasses += control.Value.Item2 ? string.Empty : " content-not-available";
                    cssClasses += " withripple";

                    <li>
                        @Html.ActionLink(
                                     control.Value.Item1,
                                     "WebControl",
                                     "Home",
                                     new { viewName = control.Key },
                                     new { @class = cssClasses })
                    </li>
                }
            </ul>
            
        </div>
        <div class="right-panel">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-sm-12">
                        <h1 class="title">@ViewBag.Title</h1>
                    </div>
                </div>
                <div class="row">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
    <footer class="footer">
        <p>Front-end team @@ Nexcel Solutions — For internal use only</p>
    </footer>
    @Html.Hidden("FrontEndGuidelinesRootUrl", Url.Content("~/"))
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/materialdesign")
    @Scripts.Render("~/bundles/layoutjs")
    @Scripts.Render("~/bundles/highlightjs")
    @RenderSection("scripts", required: false)
    <script type="text/javascript">
        $(function () {
            $.material.ripples();
            $.material.checkbox();
            $.material.radio();
        });
        SyntaxHighlighter.defaults['toolbar'] = false;
        SyntaxHighlighter.all();
    </script>
</body>
</html>