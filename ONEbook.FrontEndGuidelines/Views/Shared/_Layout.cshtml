@{
    Dictionary<string, string> webControls = ViewBag.WebControls as Dictionary<string, string>;
    string tabName = (string)ViewBag.TabName;
    bool isWebControl = ViewBag.IsWebControl != null ? (bool)ViewBag.IsWebControl : false;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Font-End Guidelines</title>
    @Styles.Render("~/Content/bootstrap")
    @Styles.Render("~/Content/materialdesign")
    @Styles.Render("~/Content/style")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <header class="header">
        <a href="#" class="logo"></a>
        <i class="glyphicon glyphicon-align-justify icon-left-panel"></i>
    </header>
    <div class="content">
        <div class="left-panel">
            <ul class="list-unstyled" id="guideLineList">
                <li>@Html.ActionLink("Introduction", "Index", "Home", new { @class = (tabName == "introduction" ? "active" : string.Empty) + " withripple" })</li>
                <li>@Html.ActionLink("Html Rules", "HtmlRules", "Home", new { @class = (tabName == "htmlrules" ? "active" : string.Empty) + " withripple" })</li>
                <li>@Html.ActionLink("CSS Rules", "CssRules", "Home", new { @class = (tabName == "cssrules" ? "active" : string.Empty) + " withripple" })</li>
                <li>@Html.ActionLink("JavaScript Rules", "JavaScriptRules", "Home", new { @class = (tabName == "javascriptrules" ? "active" : string.Empty) + " withripple" })</li>
                <li class="has-child">
                    <span class="withripple">Web Controls</span>
                    <ul class="sub-menu list-unstyled">
                        @foreach (var control in webControls)
                        {
                            <li>
                                @Html.ActionLink(
                                     control.Value,
                                     "WebControl",
                                     "Home",
                                      new { tabName = control.Key, viewName = control.Value.Replace(" ", string.Empty) },
                                      new { @class = (tabName == control.Key ? "active" : string.Empty) + " withripple" })
                            </li>
                        }
                    </ul>
                </li>
            </ul>
        </div>
        <div class="right-panel">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-sm-12">
                        <ol class=" breadcrumb cust-breadcrumb">
                            @if (isWebControl)
                            {
                                <li>Web controls</li>
                                <li><a href="#">@ViewBag.Title</a></li>
                            }
                            else
                            {
                                <li>@ViewBag.Title</li>
                            }
                        </ol>
                    </div>
                </div>
                <div class="row">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/materialdesign")
    @Scripts.Render("~/bundle/layoutjs")
    @RenderSection("scripts", required: false)
    <script>
        $(function () { 
            $.material.init();
        });
    </script>
</body>
</html>