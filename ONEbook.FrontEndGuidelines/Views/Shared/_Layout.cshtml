@{
    Dictionary<string, string> webControls = ViewBag.WebControls as Dictionary<string, string>;
    string tabName = (string)ViewBag.TabName;
    bool isWebControl = ViewBag.IsWebControl != null ? (bool)ViewBag.IsWebControl : false;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Font-End Guidelines</title>
    @Styles.Render("~/Content/bootstrap")
    @Styles.Render("~/Content/materialdesign")
    @Styles.Render("~/Content/style")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <header class="header">
        <nav class="navbar" role="navigation">
            <div class="container-fluid">
                <!-- Brand and toggle get grouped for better mobile display -->
                <div class="navbar-header">
                    <a href="#" class="logo">Front-end <span>Guideline</span></a>
                    <i class="mdi-image-dehaze icon-left-panel withripple"></i>
                    @*<a href="#" class="logo"></a>*@
                </div>
                <!-- Collect the nav links, forms, and other content for toggling -->
                <div class="navbar-collapse" id="bs-example-navbar-collapse-1">
                    <ul class="nav navbar-nav">
                        <li><a href="#">Introduction</a></li>
                        <li><a href="#">Rule</a></li>
                        <li class="active"><a href="#">Web Controls</a></li>
                    </ul>
                </div><!-- /.navbar-collapse -->
            </div><!-- /.container-fluid -->
        </nav>
        
        <i class="mdi-image-dehaze icon-left-panel withripple" id="toggleMenu"></i>
    </header>
    <div class="content" id="mainContent">
        <div class="left-panel">
            <ul class="sub-menu list-unstyled">
                @foreach (var control in webControls)
                {
                    <li>
                        @Html.ActionLink(
                                     control.Value,
                                     "WebControl",
                                     "Home",
                                      new { tabName = control.Key, viewName = control.Value.Replace(" ", string.Empty) },
                                      new { @class = (tabName == control.Key ? "active" : string.Empty) + " withripple" })
                    </li>
                }
            </ul>

            @*<ul class="list-unstyled" id="guideLineList">
                <li>@Html.ActionLink("Introduction", "Index", "Home", new { @class = (tabName == "introduction" ? "active" : string.Empty) + " withripple" })</li>
                <li>@Html.ActionLink("Html Rules", "HtmlRules", "Home", new { @class = (tabName == "htmlrules" ? "active" : string.Empty) + " withripple" })</li>
                <li>@Html.ActionLink("CSS Rules", "CssRules", "Home", new { @class = (tabName == "cssrules" ? "active" : string.Empty) + " withripple" })</li>
                <li>@Html.ActionLink("JavaScript Rules", "JavaScriptRules", "Home", new { @class = (tabName == "javascriptrules" ? "active" : string.Empty) + " withripple" })</li>
                <li class="has-child">
                    <span class="withripple menu-parent-text">Web Controls</span>
                    <ul class="sub-menu list-unstyled">
                        @foreach (var control in webControls)
                        {
                            <li>
                                @Html.ActionLink(
                                     control.Value,
                                     "WebControl",
                                     "Home",
                                      new { tabName = control.Key, viewName = control.Value.Replace(" ", string.Empty) },
                                      new { @class = (tabName == control.Key ? "active" : string.Empty) + " withripple" })
                            </li>
                        }
                    </ul>
                </li>
            </ul>*@
        </div>
        <div class="right-panel">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-sm-12">
                        <ol class=" breadcrumb cust-breadcrumb">
                            @if (isWebControl)
                            {
                                <li>Web controls</li>
                                <li><a href="#">@ViewBag.Title</a></li>
                            }
                            else
                            {
                                <li>@ViewBag.Title</li>
                            }
                        </ol>
                    </div>
                </div>
                <div class="row">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/materialdesign")
    @Scripts.Render("~/bundles/layoutjs")
    @RenderSection("scripts", required: false)
    <script>
        $(function () { 
            $.material.init();
        });
    </script>
</body>
</html>